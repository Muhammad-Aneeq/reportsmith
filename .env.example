# ReportSmith settings. Every one has a working default — a fresh clone runs the whole
# product with this file absent.

# "mock" (default) or "live". Mock is deterministic, costs nothing, and needs no key; it is
# what CI runs and what every screenshot in docs/ was produced with.
REPORTSMITH_LLM=mock

# Only read when REPORTSMITH_LLM=live. Drop your own key here and run:
#   ./make.ps1 test-live          # the live-marked tests
#   REPORTSMITH_LLM=live ./make.ps1 evals
# A full pack is three narrative sections and costs well under a cent (MODEL_COSTS.md).
# OPENAI_API_KEY=sk-...

# REPORTSMITH_MODEL=gpt-4o-mini
# REPORTSMITH_TEMPERATURE=0.3

# The generated world. Same profile + seed always gives the same pack.
# REPORTSMITH_PROFILE=squeeze
# REPORTSMITH_SEED=42

# REPORTSMITH_SIGNER_NAME=A. Controller
